rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable Authentication helper
    function isSignedIn() {
      return request.auth != null;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn();
      }
    }

    // --- CHAT REQUESTS ---
    match /chatRequests/{requestId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.get('senderId', '') || 
        request.auth.uid == resource.data.get('receiverId', '')
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.get('senderId', '');
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.get('senderId', '') || 
        request.auth.uid == resource.data.get('receiverId', '')
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('senderId', '') ||
        request.auth.uid == resource.data.get('receiverId', '')
      );
    }

    // --- CHATS & MESSAGES ---
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('members', []);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.get('members', []);
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.get('members', []) || 
        request.auth.uid in request.resource.data.get('members', [])
      );
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('members', [])
        );
        allow create: if isSignedIn() && (
          request.auth.uid == request.resource.data.get('senderId', '') && (
            !exists(/databases/$(database)/documents/chats/$(chatId)) ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('members', [])
          )
        );
        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('members', [])
        );
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.get('senderId', '') ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('members', [])
        );
      }
    }

    // --- STORIES ---
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.get('creatorId', '');
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.get('creatorId', '');
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        request.auth.uid == notificationId || 
        resource.data.get('recipientId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == notificationId || 
        resource.data.get('recipientId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == notificationId || 
        resource.data.get('recipientId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
    }

    // --- RESERVED USERNAMES ---
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.get('uid', '');
      allow delete: if isSignedIn() && request.auth.uid == resource.data.get('uid', '');
    }
  }
}
